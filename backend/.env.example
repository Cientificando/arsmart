# ==========================================================
# DJANGO
# ==========================================================
DEBUG=False
SECRET_KEY=gerar-uma-chave-longa-e-aleatoria
# Domínio do backend no Vercel + domínio próprio, se existir
ALLOWED_HOSTS=arsmart-backend.vercel.app,.vercel.app,api.arsmart.co.ao

# ==========================================================
# BASE DE DADOS — PostgreSQL (Neon, Supabase, Railway, etc.)
# ==========================================================
# Em produção usar SEMPRE DATABASE_URL (ligação pooled).
DATABASE_URL=postgresql://utilizador:password@host.neon.tech/arsmart?sslmode=require

# Alternativa (se não usar DATABASE_URL):
# DB_NAME=arsmart
# DB_USER=arsmart
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432

# Só para desenvolvimento local sem PostgreSQL instalado:
USE_SQLITE=False

# ==========================================================
# CORS / CSRF — domínios do frontend
# ==========================================================
CORS_ALLOWED_ORIGINS=https://arsmart.vercel.app,https://arsmart.co.ao
CSRF_TRUSTED_ORIGINS=https://arsmart.vercel.app,https://arsmart.co.ao,https://arsmart-backend.vercel.app

# ==========================================================
# CLOUDINARY — armazenamento de imagens e anexos
# ==========================================================
# Obter em cloudinary.com > Dashboard > Product Environment Credentials.
# Se estas três variáveis estiverem vazias, os uploads ficam guardados
# localmente (apenas adequado a desenvolvimento).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================================
# EMAIL
# ==========================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_FROM=no-reply@arsmart.co.ao

# ==========================================================
# OUTROS
# ==========================================================
WHATSAPP_NUMBER=244923766892
ANALYTICS_ID=
SECURE_SSL_REDIRECT=True
